{
  "name": "home-system",
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "ng": "ng",
    "start-local": "ng serve --host=0.0.0.0 --configuration development",
    "start": "ng serve --host=0.0.0.0 --configuration production",
    "build": "ng build",
    "build:ngssc": "ng run home-system:ngsscbuild",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:home-system": "node dist/home-system/server/server.mjs",
    "storybook": "ng run home-system:storybook",
    "build-storybook": "ng run home-system:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^20.1.3",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^20.1.3",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/ssr": "^21.2.31",
    "@js-joda/core": "^6.0.0",
    "@sbb-esta/lyne-angular": "20.0.0-rc.11",
    "@sbb-esta/lyne-elements": "3.13.3",
    "angular-server-side-configuration": "20.0.0",
    "express": "^5.1.0",
    "igniteui-angular": "20.0.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.31",
    "@angular/cli": "^21.2.31",
    "@angular/compiler-cli": "^21.2.26",
    "@chromatic-com/storybook": "^4.0.1",
    "@types/express": "^5.0.3",
    "@types/jasmine": "~5.1.8",
    "@types/node": "^24.2.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "5.9.3"
  }
