{
  "name": "home-system",
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "ng": "ng",
    "start-local": "ng serve --host=0.0.0.0 --configuration development",
    "start": "ng serve --host=0.0.0.0 --configuration production",
    "build": "ng build",
    "build:ngssc": "ng run home-system:ngsscbuild",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:home-system": "node dist/home-system/server/server.mjs",
    "storybook": "ng run home-system:storybook",
    "build-storybook": "ng run home-system:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/ssr": "22.3.0",
    "@js-joda/core": "6.3.2",
    "@sbb-esta/lyne-angular": "22.12.0",
    "@sbb-esta/lyne-elements": "5.14.0",
    "angular-server-side-configuration": "22.1.1",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@chromatic-com/storybook": "5.6.0",
    "@types/express": "5.0.6",
    "@types/jasmine": "7.0.0",
    "@types/node": "26.6.7",
    "jasmine-core": "7.0.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
